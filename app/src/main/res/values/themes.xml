<resources>
    <style name="Theme.RotaCerta" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F4F6FA</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#F4F6FA</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tela de abertura clara com o logo; logo em seguida a MainActivity mostra a abertura animada
         (IntroScreen), que começa exatamente igual a esta pra transição ser contínua. -->
    <style name="Theme.RotaCerta.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.RotaCerta</item>
    </style>
</resources>
